# ==============================================================================
# zayneessence — Environment Variables (.env.example)
# ==============================================================================

# 1. App & URL Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Set to "mock" (default) to use built-in seed + localStorage data layer, or "api" to connect to NestJS + Postgres
NEXT_PUBLIC_DATA_MODE="mock"

# 2. Database & Storage (Postgres / Supabase Storage)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zayneessence?schema=public"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="product-photography"

# 3. Payments — Paystack (Primary) & Flutterwave (Fallback)
# All amounts are processed in NGN and stored as integers in kobo (e.g., ₦85,000 = 8500000)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_WEBHOOK_HASH="zayneessence_flw_webhook_secret"

# 4.Transactional Email — Resend
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="zayneessence <orders@zayneessence.com>"

# 5. WhatsApp Business Cloud API (Behind feature flag — store works without it)
NEXT_PUBLIC_ENABLE_WHATSAPP_UPDATES="false"
WHATSAPP_CLOUD_API_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID="100000000000000"
WHATSAPP_ACCESS_TOKEN="EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_BUSINESS_ACCOUNT_ID="100000000000000"

# 6. Admin Demo / Auth Secret
JWT_SECRET="replace-with-secure-64-char-secret-in-production"
NEXT_PUBLIC_ADMIN_PASSCODE="zayne-studio-admin"
